# Copy to .env and fill in. .env is gitignored; this file is not.

# --- environment ---
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# --- database ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medicine_scanner
# "db" is the compose service name. Use "localhost" when running uvicorn
# directly on the host against a containerised database.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- auth (required) ---
# The app refuses to start without this.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=10080

# Optional. Google sign-in returns 501 until this is set.
GOOGLE_CLIENT_ID=

# --- LLM (optional) ---
# Without this the OCR endpoint falls back to rule-based extraction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- HTTP ---
# Comma-separated. Only needed for Expo web; React Native ignores CORS.
CORS_ORIGINS=
# Comma-separated Host allowlist. Set real hostnames in production.
ALLOWED_HOSTS=*

RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SCAN=60/minute
