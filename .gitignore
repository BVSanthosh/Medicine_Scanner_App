# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
# These are path-anchored, so they must track where the app lives.
client/ios
client/android

# --- server (FastAPI) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Secrets. Never commit a real .env - keep .env.example checked in instead.
.env

# Claude Code: .claude/settings.json is shared project config and IS committed.
# Only personal overrides (locally approved permissions, machine paths) are not.
.claude/settings.local.json
